{
  "name": "aem-ams-mcp",
  "version": "1.7.1",
  "description": "Fork of easingthemes/aem-mcp-server for AEM AMS 6.5 LTS, adding LLM content-review and Figma->AEM design-token tools.",
  "license": "AGPL-3.0-only",
  "private": true,
  "mcpName": "io.github.alessio-g/aem-ams-mcp",
  "fork": {
    "upstream": "https://github.com/easingthemes/aem-mcp-server",
    "note": "Adds content-review + design-token tools on top of the upstream tools; no upstream tools removed or modified."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alessio-G/aem-ams-mcp.git"
  },
  "keywords": [
    "AEM",
    "MCP",
    "Model Context Protocol",
    "LLM",
    "Adobe Experience Manager",
    "TypeScript"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "aem-mcp": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:types && npm run build:ts",
    "build:ts": "esbuild $(find src -name '*.ts' ! -path 'src/__tests__/*') --outdir=dist --platform=node --minify",
    "build:types": "tsc --emitDeclarationOnly",
    "test": "npm run build:ts && node --test test/*.test.js",
    "test:jest": "jest",
    "start": "MCP_LOGGER=true node dist/cli.js",
    "test:dev": "node ./dist/cli.js",
    "test:npm": "npm pack && npm install -g ./aem-ams-mcp-$npm_package_version.tgz && aem-mcp -e -H=http://localhost:5502"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "yargs": "^18.0.0",
    "zod": "3.24.4",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/yargs": "^17.0.33",
    "esbuild": "^0.25.9",
    "jest": "^30.4.2",
    "pptxgenjs": "^4.0.1",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.2"
  },
  "type": "module"
}
